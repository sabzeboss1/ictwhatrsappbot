# ========================================================
# ICT WhatsApp AI — Variables d'environnement
# ========================================================

# --- Application Backend ---
PORT=3001
NODE_ENV=development
JWT_SECRET=super_secret_jwt_key_ict_whatsapp_2026_change_in_prod

# --- Base de données ---
# Pour PostgreSQL (Production ou Docker) :
DATABASE_URL=postgresql://ict_user:ict_password@localhost:5432/ict_whatsapp?schema=public
# En local Windows si postgres n'est pas actif, vous pouvez utiliser SQLite ou PostgreSQL
# DATABASE_URL=file:./dev.db

# --- Redis & File de messages ---
REDIS_URL=redis://localhost:6379

# --- Intelligence Artificielle (au moins une clé requise pour les vrais appels) ---
# Si aucune clé n'est fournie, l'application bascule automatiquement sur son simulateur IA heuristique intégré.
AI_PROVIDER=gemini # gemini, openai ou anthropic
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=

# --- Evolution API (WhatsApp) ---
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=B6D711FCDE4D4FD5936544120E713976
EVOLUTION_INSTANCE_NAME=ict-main
EVOLUTION_WEBHOOK_SECRET=ict_evolution_secret_token_2026

# --- HubSpot CRM ---
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PIPELINE_ID=default

# --- Frontend ---
VITE_API_URL=http://localhost:3001
VITE_SOCKET_URL=http://localhost:3001
