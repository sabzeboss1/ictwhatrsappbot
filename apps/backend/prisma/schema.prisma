generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id                    String    @id @default(cuid())
  phone                 String    @unique
  realPhone             String?   // Vrai numéro de téléphone si le contact utilise un identifiant masqué (@lid)
  whatsappLid           String?   // Identifiant LID WhatsApp natif (@lid)
  firstName             String?
  lastName              String?
  email                 String?
  company               String?
  source                String    @default("whatsapp")
  campaign              String?
  customerType          String?   // Particulier, Couple, Famille, Groupe, Entreprise, Ecole, ONG, Administration, Inconnu
  conversationStage     String    @default("NEW_CONTACT") // NEW_CONTACT, DISCOVERY, QUALIFICATION, RECOMMENDATION, OBJECTION_HANDLING, CONVERSION, CUSTOMER
  intent                String?   // Decouverte, Information, Reservation, SAV, Autre
  need                  String?
  participantsCount     Int?
  preferredDate         String?
  budget                String?
  recommendedOffer      String?
  quotedPrice           String?   // Prix communiqué au prospect pour l'offre (ex: "75 000 FCFA / pers")
  estimatedAmount       Int?      // Montant total estimé du deal en FCFA (pour tri, export, pipeline)
  closingNotes          String?   // Notes internes du closer (jamais envoyées au prospect)
  productIdentified     Boolean   @default(false)
  purchaseIntent        String?   // information, interesse, demande_prix, veut_reserver
  availabilityConfirmed Boolean   @default(false)
  productStandard       Boolean   @default(false)
  customRequest         Boolean   @default(false)
  isB2B                 Boolean   @default(false)
  isVip                 Boolean   @default(false)
  interactionLevel      String?   // repond_peu, dialogue_actif, fournit_toutes_infos
  objections            String[]  @default([])
  qualificationScore    Int       @default(0)
  leadStatus            String?   // Prospect froid, Prospect tiede, Prospect qualifie, Opportunite chaude
  nextStep              String?   // Nurturing, Continuer qualification, Landing Page, Paiement, Conseiller humain
  aiDisabled            Boolean   @default(false)
  assignedAgentId       String?
  hubspotContactId      String?
  hubspotDealId         String?
  hubspotSyncStatus     String    @default("pending") // pending | synced | failed
  hubspotLastError      String?

  // ── Module de relance ──
  optOut                Boolean   @default(false) // Le prospect a demandé à ne plus être contacté (STOP)
  optOutAt              DateTime?
  followUpPaused        Boolean   @default(false) // Relances automatiques désactivées pour ce lead
  followUpCount         Int       @default(0)     // Nb de relances auto envoyées depuis la dernière réponse du prospect
  lastFollowUpAt        DateTime?
  lastInboundAt         DateTime?
  lastOutboundAt        DateTime?

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  messages              Message[]
  followUps             FollowUp[]
  assignedAgent         User?     @relation(fields: [assignedAgentId], references: [id])
}

model FollowUp {
  id            String    @id @default(cuid())
  leadId        String
  lead          Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type          String    @default("manual") // auto | manual
  step          Int       @default(0)        // Rang de la relance automatique (1, 2, 3...)
  status        String    @default("pending") // pending | sent | cancelled | failed | skipped
  scheduledAt   DateTime
  sentAt        DateTime?
  message       String
  error         String?
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, scheduledAt])
  @@index([leadId])
}

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Message {
  id                String   @id @default(cuid())
  leadId            String
  lead              Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  direction         String   // inbound | outbound
  content           String
  messageType       String   @default("text")
  whatsappMessageId String?  @unique
  sentByAgentId     String?
  createdAt         DateTime @default(now())
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("agent") // admin | agent
  createdAt    DateTime @default(now())
  leads        Lead[]
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entityId  String
  metadata  Json?
  createdAt DateTime @default(now())
}

model PromptTemplate {
  id          String   @id @default(cuid())
  name        String                          // Ex: "ICT Tourisme", "Campagne Facebook Kribi"
  slug        String   @unique                // identifiant unique machine
  description String?                         // Description courte
  prompt      String                          // Le contenu du system prompt
  isActive    Boolean  @default(false)        // Un seul template actif à la fois
  isDefault   Boolean  @default(false)        // Template par défaut (non supprimable)
  campaign    String?                         // Nom de campagne associée (optionnel)
  version     String   @default("1.0.0")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
